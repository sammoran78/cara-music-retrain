# Local dashboard connection to Azure Machine Learning.
# Create with: [ -e .env ] || cp .env.example .env
# Never overwrite an existing .env because it may contain local secrets.
AZUREML_SUBSCRIPTION_ID=
AZUREML_RESOURCE_GROUP=
AZUREML_WORKSPACE_NAME=
AZUREML_DATASTORE_NAME=ds_cara_raw_audio
AZUREML_RAW_AUDIO_PATH=test-audio/

# Store remote training secrets in Azure Key Vault. These local values are only
# for local preparation and testing when needed.
HF_TOKEN=
WANDB_API_KEY=
FREESOUND_CLIENT_ID=
FREESOUND_CLIENT_SECRET=
FREESOUND_ACCESS_TOKEN=
FREESOUND_REFRESH_TOKEN=

# OpenAI Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_REASONING_EFFORT=high